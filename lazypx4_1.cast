[53.127886, "o", "\u001b[?2026h\u001b[H\u001b[2m╭─\u001b[0m\u001b[1m PANELS \u001b[0m\u001b[2m────────────────╮\u001b[0m \u001b[1m\u001b[36m╭─\u001b[0m\u001b[1m PX4 EVENT · WARNING · FAILSAFE LOG \u001b[0m\u001b[1m\u001b[36m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  DASHBOARD\u001b[0m               \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m PX4: GCS connection regained                                                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.12793, "o", "\u001b[2m│\u001b[0m\u001b[2m  MODE [m]\u001b[0m                \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Console ready                                                                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m ARM/DISARM are explicit commands                                                                                                                              \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128027, "o", "\u001b[2m│\u001b[0m\u001b[1m\u001b[36m› EVENT LOG [g]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Heartbeat is authoritative for actual ARM state                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m [T] takeoff  [L] land  [R] return-to-launch  (or pick the mode with [m])                                                                                      \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128054, "o", "\u001b[2m│\u001b[0m\u001b[2m  MAP [n]\u001b[0m                 \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Use [m] MODE for all other PX4 flight-mode changes                                                                                                            \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128091, "o", "\u001b[2m│\u001b[0m\u001b[2m  NSH SHELL [t]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [p] for PX4 parameters ([/] to filter)                                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128128, "o", "\u001b[2m│\u001b[0m\u001b[2m  LIDAR POINTS [v]\u001b[0m        \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [e] estimation, [c] control/setpoints, [n] position map                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128186, "o", "\u001b[2m│\u001b[0m\u001b[2m  CAMERA [w]\u001b[0m              \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [s] for sensor calibration (gyro / accel / level / compass / baro)                                                                                      \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128236, "o", "\u001b[2m│\u001b[0m\u001b[2m  RC INPUT [r]\u001b[0m            \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m On the map, [i] saves a pinned satellite image to ./px4_maps                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128286, "o", "\u001b[2m│\u001b[0m\u001b[2m  USB / NETWORK [u]\u001b[0m       \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [l] for PX4 flight logs; downloads go to ./px4_logs ([u] upload to web, [a] EKF health-check)                                                           \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128337, "o", "\u001b[2m│\u001b[0m\u001b[2m  CONTROL [c]\u001b[0m             \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [f] to flash firmware from ./px4_firmware                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128385, "o", "\u001b[2m│\u001b[0m\u001b[2m  ESTIMATION [e]\u001b[0m          \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [v] for a LiDAR point-cloud overview (/x500_lidar_3d_cam/livox/points)                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[53.128438, "o", "\u001b[2m│\u001b[0m\u001b[2m  CALIBRATE [s]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [r] for RC stick positions / channels, [w] for a camera preview (/x500_lidar_3d_cam/rgb/image)                                                          \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
