[41.439808, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  DASHBOARD\u001b[0m               \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m Vehicle: \u001b[31m\u001b[1mARMED - calibration is blocked\u001b[0m                                                                                                                                        \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  MAP [n]\u001b[0m                 \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m Sensor health:  IMU \u001b[32mOK\u001b[0m   MAG \u001b[32mOK\u001b[0m   BARO \u001b[32mOK\u001b[0m   GPS \u001b[32mOK\u001b[0m                                                                                                                             \u001b[2m│\u001b[0m\u001b[K\r\n"]
