[48.621477, "o", "\u001b[?2026h\u001b[H\u001b[2m╭─\u001b[0m\u001b[1m PANELS \u001b[0m\u001b[2m────────────────╮\u001b[0m \u001b[1m\u001b[36m╭─\u001b[0m\u001b[1m PX4 EVENT · WARNING · FAILSAFE LOG \u001b[0m\u001b[1m\u001b[36m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  DASHBOARD\u001b[0m               \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m PX4: GCS connection regained                                                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  MODE [m]\u001b[0m                \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Console ready                                                                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[48.621631, "o", "\u001b[2m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m ARM/DISARM are explicit commands                                                                                                                              \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[1m\u001b[36m› EVENT LOG [g]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Heartbeat is authoritative for actual ARM state                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m [T] \u001b[7mtake\u001b[27moff  [L] land  [R] return-to-launch  (or pick the mode with [m])                                                                                      \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  MAP [n]\u001b[0m                 \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Use [m] MODE for all other PX4 flight-mode changes                                                                                                            \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[48.621704, "o", "\u001b[2m│\u001b[0m\u001b[2m  NSH SHELL [t]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [p] for PX4 parameters ([/] to filter)                                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  LIDAR POINTS [v]\u001b[0m        \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [e] estimation, [c] control/setpoints, [n] position map                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
