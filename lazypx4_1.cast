[88.096277, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  EVENT LOG [g]\u001b[0m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[1m Select a calibration (vehicle must be DISARMED):\u001b[0m                                                                                                                               \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m                                                                                                                                                                                \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  MAP [n]\u001b[0m                 \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [g]  Gyroscope               \u001b[2mkeep the vehicle completely still (~5 s)\u001b[0m                                                                                                        \u001b[2m│\u001b[0m\u001b[K\r\n"]
[88.096307, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  NSH SHELL [t]\u001b[0m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [a]  Accelerometer           \u001b[2mplace on each of the 6 sides when prompted\u001b[0m                                                                                                      \u001b[2m│\u001b[0m\u001b[K\r\n"]
