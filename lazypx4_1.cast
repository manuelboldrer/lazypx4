[74.173091, "o", "\u001b[?2026h\u001b[H\u001b[1m\u001b[36m╭─\u001b[0m\u001b[1m PANELS \u001b[0m\u001b[1m\u001b[36m────────────────╮\u001b[0m \u001b[2m╭─\u001b[0m\u001b[1m PX4 POSITION MAP · plan view, up = North \u001b[0m\u001b[2m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  DASHBOARD\u001b[0m               \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m range +/-  30.0 m      \u001b[2mcell ~  0.6 m x  2.7 m\u001b[0m                                                                                                                                  \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  MODE [m]\u001b[0m                \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m                                                                                                                                                                                \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m                                                     │                                                                                                                          \u001b[2m│\u001b[0m\u001b[K\r\n"]
