[53.929431, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[7m› EVENT LOG [g]\u001b[27m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Heartbeat is authoritative for actual ARM state                                                                                                               \u001b[2m│\u001b[0m\u001b[K\r\n"]
[53.929478, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m [T] takeoff  [L] land  [R] return-to-launch  (or pick the mode with [m])                                                                                      \u001b[2m│\u001b[0m\u001b[K\r\n"]
