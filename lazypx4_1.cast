[38.555823, "o", "\u001b[1m\u001b[36m│\u001b[0m                          \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   \u001b[31m⠐\u001b[0m  \u001b[31m⠂\u001b[0m \u001b[31m⠂\u001b[0m \u001b[31m⠐\u001b[0m \u001b[31m⠐\u001b[0m \u001b[31m⠐\u001b[0m              \u001b[32m⢐\u001b[0m\u001b[32m⡂\u001b[0m \u001b[34m⢀\u001b[0m   \u001b[34m⠡\u001b[0m \u001b[34m⠠\u001b[0m \u001b[34m⠁\u001b[0m\u001b[34m⠂\u001b[0m \u001b[34m⠉\u001b[0m \u001b[34m⠈\u001b[0m      \u001b[34m⠰\u001b[0m\u001b[1m+\u001b[0m\u001b[34m⡦\u001b[0m      \u001b[34m⠁\u001b[0m \u001b[34m⠁\u001b[0m\u001b[34m⠁\u001b[0m\u001b[34m⠂\u001b[0m\u001b[34m⠁\u001b[0m \u001b[34m⠂\u001b[0m\u001b[34m⠁\u001b[0m\u001b[34m⠂\u001b[0m \u001b[34m⡀\u001b[0m  \u001b[34m⡐\u001b[0m          \u001b[34m⢀\u001b[0m \u001b[34m⠁\u001b[0m      \u001b[31m⠁\u001b[0m\u001b[31m⠁\u001b[0m  \u001b[31m⠁\u001b[0m\u001b[34m⠈\u001b[0m\u001b[31m⠈\u001b[0m  \u001b[31m⠁\u001b[0m                                                                       \u001b[2m│\u001b[0m\u001b[K\r\n"]
