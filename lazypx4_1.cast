[45.114605, "o", "\u001b[2m│\u001b[0m\u001b[2m  FLASH FIRMWARE [f]\u001b[0m      \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [f] to flash firmware from ./px4_firmware                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  ABOUT [?]\u001b[0m               \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [v] for a LiDAR point-cloud overview (/x500_lidar_3d_cam/livox/points)                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
