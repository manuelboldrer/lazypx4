[88.998346, "o", "\u001b[?2026h\u001b[H\u001b[1m\u001b[36m╭─\u001b[0m\u001b[1m PANELS \u001b[0m\u001b[1m\u001b[36m────────────────╮\u001b[0m \u001b[2m╭─\u001b[0m\u001b[1m PX4 SENSOR CALIBRATION \u001b[0m\u001b[2m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  DASHBOARD\u001b[0m               \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m Vehicle: \u001b[32mDISARMED\u001b[0m                                                                                                                                                              \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  MODE [m]\u001b[0m                \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m Sensor health:  IMU \u001b[32mOK\u001b[0m   MAG \u001b[32mOK\u001b[0m   BARO \u001b[32mOK\u001b[0m   GPS \u001b[32mOK\u001b[0m                                                                                                                             \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m                                                                                                                                                                                \u001b[2m│\u001b[0m\u001b[K\r\n"]
[88.998377, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  EVENT LOG [g]\u001b[0m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[1m Select a calibration (vehicle must be DISARMED):\u001b[0m                                                                                                                               \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m                                                                                                                                                                                \u001b[2m│\u001b[0m\u001b[K\r\n"]
[88.998482, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  MAP [n]\u001b[0m                 \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [g]  Gyroscope               \u001b[2mkeep the vehicle completely still (~5 s)\u001b[0m                                                                                                        \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  NSH SHELL [t]\u001b[0m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [a]  Accelerometer           \u001b[2mplace on each of the 6 sides when prompted\u001b[0m                                                                                                      \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  LIDAR POINTS [v]\u001b[0m        \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [l]  Level horizon           \u001b[2mset the vehicle exactly level, keep still\u001b[0m                                                                                                       \u001b[2m│\u001b[0m\u001b[K\r\n"]
[88.998532, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  CAMERA [w]\u001b[0m              \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [c]  Compass / magnetometer  \u001b[2mrotate about all axes when prompted\u001b[0m                                                                                                             \u001b[2m│\u001b[0m\u001b[K\r\n"]
