[46.719135, "o", "\u001b[2m│\u001b[0m\u001b[2m  MODE [m]\u001b[0m                \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Console ready                                                                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719203, "o", "\u001b[2m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m ARM/DISARM are explicit commands                                                                                                                              \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719225, "o", "\u001b[2m│\u001b[0m\u001b[1m\u001b[36m› EVENT LOG [g]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Heartbeat is authoritative for actual ARM state                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719309, "o", "\u001b[2m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m [T] takeoff  [L] land  [R] return-to-launch  (or pick the mode with [m])                                                                                      \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719387, "o", "\u001b[2m│\u001b[0m\u001b[2m  MAP [n]\u001b[0m                 \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Use [m] MODE for all other PX4 flight-mode changes                                                                                                            \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719453, "o", "\u001b[2m│\u001b[0m\u001b[2m  NSH SHELL [t]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [p] for PX4 parameters ([/] to filter)                                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719518, "o", "\u001b[2m│\u001b[0m\u001b[2m  LIDAR POINTS [v]\u001b[0m        \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [e] estimation, [c] control/setpoints, [n] position map                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719621, "o", "\u001b[2m│\u001b[0m\u001b[2m  CAMERA [w]\u001b[0m              \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [s] for sensor calibration (gyro / accel / level / compass / baro)                                                                                      \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719673, "o", "\u001b[2m│\u001b[0m\u001b[2m  RC INPUT [r]\u001b[0m            \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m On the map, [i] saves a pinned satellite image to ./px4_maps                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719716, "o", "\u001b[2m│\u001b[0m\u001b[2m  USB / NETWORK [u]\u001b[0m       \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [l] for PX4 flight logs; downloads go to ./px4_logs ([u] upload to web, [a] EKF health-check)                                                           \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719783, "o", "\u001b[2m│\u001b[0m\u001b[2m  CONTROL [c]\u001b[0m             \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [f] to flash firmware from ./px4_firmware                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.719852, "o", "\u001b[2m│\u001b[0m\u001b[2m  ESTIMATION [e]\u001b[0m          \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [v] for a LiDAR point-cloud overview (/x500_lidar_3d_cam/livox/points)                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[46.720018, "o", "\u001b[2m│\u001b[0m\u001b[2m  CALIBRATE [s]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [r] for RC stick positions / channels, [w] for a camera preview (/x500_lidar_3d_cam/rgb/image)                                                          \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  FLASH FIRMWARE [f]\u001b[0m      \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:40\u001b[0m \u001b[37mINFO    \u001b[0m PX4 MODE: UNKNOWN -> LOITER                                                                                                                                   \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  ABOUT [?]\u001b[0m               \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:47\u001b[0m \u001b[36mCOMMAND \u001b[0m ARM command SENT                                                                                                                                              \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m                          \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:47\u001b[0m \u001b[36mCOMMAND \u001b[0m ARM: waiting for HEARTBEAT confirmation                                                                                                                       \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
