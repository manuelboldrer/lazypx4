[50.324731, "o", "\u001b[2m│\u001b[0m\u001b[2m  CALIBRATE [s]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [r] for RC stick positions / channels, [w] for a camera preview (/x500_lidar_3d_cam/rgb/image)                                                          \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
