[54.332384, "o", "\u001b[?2026h\u001b[H\u001b[1m\u001b[36m╭─\u001b[0m\u001b[1m PANELS \u001b[0m\u001b[1m\u001b[36m────────────────╮\u001b[0m \u001b[2m╭─\u001b[0m\u001b[1m PX4 FLIGHT LOGS \u001b[0m\u001b[2m─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  DASHBOARD\u001b[0m               \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m Status: \u001b[2mNOT LOADED\u001b[0m    Logs: 0                                                                                                                                                  \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  MODE [m]\u001b[0m                \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m                                                                                                                                                                                \u001b[2m│\u001b[0m\u001b[K\r\n"]
