[50.424063, "o", "\u001b[2m│\u001b[0m\u001b[2m  CALIBRATE [s]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [r] for RC stick positions / channels, [w] for a camera preview (/x500_lidar_3d_cam/rgb/image)                                                          \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[50.424127, "o", "\u001b[2m│\u001b[0m\u001b[2m  FLASH FIRMWARE [f]\u001b[0m      \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:40\u001b[0m \u001b[37mINFO    \u001b[0m PX4 MODE: UNKNOWN -> LOITER                                                                                                                                   \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  ABOUT [?]\u001b[0m               \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:47\u001b[0m \u001b[36mCOMMAND \u001b[0m ARM command SENT                                                                                                                                              \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
