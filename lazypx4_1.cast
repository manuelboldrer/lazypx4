[24.769938, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m PX4 vehicle locked: system=1, component=0                                                                                                                     \u001b[2m│\u001b[0m\u001b[K\r\n"]
[24.769974, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[7m› EVENT LOG [g]\u001b[27m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m PX4 modes: ACRO, ALTCTL, FOLLOWME, LAND, LOITER, MANUAL, MISSION, OFFBOARD, POSCTL, RATTITUDE, RTGS, RTL, STABILIZED, TAKEOFF                                 \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m MAVLink receiver thread started                                                                                                                               \u001b[2m│\u001b[0m\u001b[K\r\n"]
[24.770008, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  MAP [n]\u001b[0m                 \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m PX4: GCS connection regained                                                                                                                                  \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  NSH SHELL [t]\u001b[0m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Console ready                                                                                                                                                 \u001b[2m│\u001b[0m\u001b[K\r\n"]
