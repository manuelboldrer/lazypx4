[16.658128, "o", "\u001b[1m\u001b[36m│\u001b[0m                          \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m  \u001b[33m⠁\u001b[0m\u001b[33m⠈\u001b[0m \u001b[33m⠐\u001b[0m \u001b[33m⠂\u001b[0m\u001b[33m⠐\u001b[0m \u001b[33m⠐\u001b[0m \u001b[33m⠄\u001b[0m\u001b[33m⠠\u001b[0m\u001b[33m⠠\u001b[0m\u001b[33m⢀\u001b[0m \u001b[33m⢁\u001b[0m\u001b[33m⢈\u001b[0m\u001b[33m⠈\u001b[0m\u001b[33m⡂\u001b[0m\u001b[33m⠐\u001b[0m\u001b[33m⠐\u001b[0m \u001b[33m⠤\u001b[0m \u001b[33m⠈\u001b[0m\u001b[33m⠈\u001b[0m \u001b[36m⢀\u001b[0m\u001b[36m⡂\u001b[0m \u001b[36m⠌\u001b[0m  \u001b[36m⡐\u001b[0m \u001b[36m⠰\u001b[0m\u001b[36m⠂\u001b[0m\u001b[36m⡡\u001b[0m\u001b[36m⠐\u001b[0m\u001b[36m⡁\u001b[0m\u001b[36m⢎\u001b[0m\u001b[36m⠴\u001b[0m\u001b[36m⠳\u001b[0m\u001b[36m⠪\u001b[0m\u001b[36m⠪\u001b[0m\u001b[36m⠚\u001b[0m\u001b[36m⠛\u001b[0m\u001b[36m⠛\u001b[0m\u001b[36m⠛\u001b[0m\u001b[36m⠙\u001b[0m\u001b[36m⠓\u001b[0m\u001b[36m⠛\u001b[0m\u001b[36m⠛\u001b[0m\u001b[36m⠓\u001b[0m\u001b[36m⠛\u001b[0m\u001b[36m⠛\u001b[0m\u001b[36m⠛\u001b[0m\u001b[36m⠏\u001b[0m\u001b[36m⠟\u001b[0m\u001b[36m⠝\u001b[0m\u001b[36m⠖\u001b[0m\u001b[36m⠇\u001b[0m\u001b[36m⠵\u001b[0m\u001b[36m⢈\u001b[0m\u001b[36m⠢\u001b[0m\u001b[36m⡁\u001b[0m\u001b[36m⢊\u001b[0m\u001b[36m⠂\u001b[0m\u001b[36m⢠\u001b[0m\u001b[36m⠁\u001b[0m\u001b[36m⠐\u001b[0m\u001b[36m⠄\u001b[0m\u001b[36m⠁\u001b[0m \u001b[36m⡂\u001b[0m \u001b[36m⠁\u001b[0m  \u001b[36m⠄\u001b[0m\u001b[33m⠐\u001b[0m\u001b[33m⠐\u001b[0m\u001b[36m⠂\u001b[0m\u001b[33m⠁\u001b[0m\u001b[33m⢁\u001b[0m\u001b[33m⡁\u001b[0m\u001b[36m⠠\u001b[0m\u001b[33m⠄\u001b[0m\u001b[33m⠄\u001b[0m\u001b[33m⠄\u001b[0m \u001b[33m⠐\u001b[0m \u001b[33m⠂\u001b[0m\u001b[33m⠐\u001b[0m \u001b[33m⠁\u001b[0m \u001b[33m⠁\u001b[0m   \u001b[33m⢀\u001b[0m                                                                       \u001b[2m│\u001b[0m\u001b[K\r\n"]
[16.658252, "o", "\u001b[1m\u001b[36m│\u001b[0m                          \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   \u001b[33m⠁\u001b[0m \u001b[33m⠂\u001b[0m \u001b[33m⠂\u001b[0m \u001b[33m⠂\u001b[0m \u001b[33m⠂\u001b[0m \u001b[33m⠄\u001b[0m \u001b[33m⠄\u001b[0m\u001b[33m⠄\u001b[0m \u001b[33m⠄\u001b[0m   \u001b[33m⠁\u001b[0m      \u001b[32m⢀\u001b[0m\u001b[32m⡂\u001b[0m \u001b[36m⠈\u001b[0m  \u001b[36m⠂\u001b[0m \u001b[36m⠁\u001b[0m                              \u001b[36m⠈\u001b[0m \u001b[36m⠐\u001b[0m  \u001b[36m⠁\u001b[0m \u001b[36m⠂\u001b[0m\u001b[36m⠐\u001b[0m \u001b[34m⢀\u001b[0m  \u001b[36m⠌\u001b[0m     \u001b[36m⠐\u001b[0m \u001b[33m⠐\u001b[0m  \u001b[33m⠒\u001b[0m  \u001b[33m⠂\u001b[0m \u001b[33m⠁\u001b[0m\u001b[33m⠁\u001b[0m\u001b[36m⠁\u001b[0m\u001b[33m⠁\u001b[0m \u001b[33m⠈\u001b[0m                                                                         \u001b[2m│\u001b[0m\u001b[K\r\n"]
