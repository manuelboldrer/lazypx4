[73.771933, "o", "\u001b[?2026h\u001b[H\u001b[1m\u001b[36m╭─\u001b[0m\u001b[1m PANELS \u001b[0m\u001b[1m\u001b[36m────────────────╮\u001b[0m \u001b[2m╭─\u001b[0m\u001b[1m PX4 MAVLINK SHELL · NSH \u001b[0m\u001b[2m─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  DASHBOARD\u001b[0m               \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m Session: \u001b[2mNOT OPENED\u001b[0m    Last output: --    Scroll: FOLLOW                                                                                                                       \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  MODE [m]\u001b[0m                \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m                                                                                                                                                                                \u001b[2m│\u001b[0m\u001b[K\r\n"]
[73.772002, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m (no output yet - try pressing ENTER)\u001b[0m                                                                                                                                           \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  EVENT LOG [g]\u001b[0m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m                                                                                                                                                                                \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0mType to send    ENTER = run    Ctrl+C = interrupt                                                                                                                               \u001b[2m│\u001b[0m\u001b[K\r\n"]
