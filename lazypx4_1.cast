[24.770121, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  RC INPUT [r]\u001b[0m            \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m [T] takeoff  [L] land  [R] return-to-launch  (or pick the mode with [m])                                                                                      \u001b[2m│\u001b[0m\u001b[K\r\n"]
[24.77016, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  USB / NETWORK [u]\u001b[0m       \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Use [m] MODE for all other PX4 flight-mode changes                                                                                                            \u001b[2m│\u001b[0m\u001b[K\r\n"]
[24.7702, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  CONTROL [c]\u001b[0m             \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [p] for PX4 parameters ([/] to filter)                                                                                                                  \u001b[2m│\u001b[0m\u001b[K\r\n"]
