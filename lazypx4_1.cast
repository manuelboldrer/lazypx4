[41.442049, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[7m› CALIBRATE [s]\u001b[27m           \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [a]  Accelerometer           \u001b[2mplace on each of the 6 sides when prompted\u001b[0m                                                                                                      \u001b[2m│\u001b[0m\u001b[K\r\n"]
[41.442263, "o", "\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  USB / NETWORK [u]\u001b[0m       \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [l]  Level horizon           \u001b[2mset the vehicle exactly level, keep still\u001b[0m                                                                                                       \u001b[2m│\u001b[0m\u001b[K\r\n\u001b[1m\u001b[36m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[1m\u001b[36m│\u001b[0m \u001b[2m│\u001b[0m   [c]  Compass / magnetometer  \u001b[2mrotate about all axes when prompted\u001b[0m                                                                                                             \u001b[2m│\u001b[0m\u001b[K\r\n"]
