[50.924916, "o", "\u001b[2m│\u001b[0m\u001b[2m  MODE [m]\u001b[0m                \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Console ready                                                                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[50.924965, "o", "\u001b[2m│\u001b[0m\u001b[2m  PARAMETERS [p]\u001b[0m          \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m ARM/DISARM are explicit commands                                                                                                                              \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[1m\u001b[36m› EVENT LOG [g]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Heartbeat is authoritative for actual ARM state                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  FLIGHT LOGS [l]\u001b[0m         \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m [T] \u001b[7mtakeoff\u001b[27m  [L] land  [R] return-to-launch  (or pick the mode with [m])                                                                                      \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  MAP [n]\u001b[0m                 \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Use [m] MODE for all other PX4 flight-mode changes                                                                                                            \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[50.925001, "o", "\u001b[2m│\u001b[0m\u001b[2m  NSH SHELL [t]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [p] for PX4 parameters ([/] to filter)                                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[50.925034, "o", "\u001b[2m│\u001b[0m\u001b[2m  LIDAR POINTS [v]\u001b[0m        \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [e] estimation, [c] control/setpoints, [n] position map                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[50.925066, "o", "\u001b[2m│\u001b[0m\u001b[2m  CAMERA [w]\u001b[0m              \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [s] for sensor calibration (gyro / accel / level / compass / baro)                                                                                      \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[50.925102, "o", "\u001b[2m│\u001b[0m\u001b[2m  RC INPUT [r]\u001b[0m            \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m On the map, [i] saves a pinned satellite image to ./px4_maps                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[50.925133, "o", "\u001b[2m│\u001b[0m\u001b[2m  USB / NETWORK [u]\u001b[0m       \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [l] for PX4 flight logs; downloads go to ./px4_logs ([u] upload to web, [a] EKF health-check)                                                           \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[50.925168, "o", "\u001b[2m│\u001b[0m\u001b[2m  CONTROL [c]\u001b[0m             \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [f] to flash firmware from ./px4_firmware                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
