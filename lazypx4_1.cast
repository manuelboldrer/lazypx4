[48.321354, "o", "\u001b[2m│\u001b[0m\u001b[2m  NSH SHELL [t]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [p] for PX4 parameters ([/] to filter)                                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  LIDAR POINTS [v]\u001b[0m        \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [e] estimation, [c] control/setpoints, [n] position map                                                                                                 \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[48.321407, "o", "\u001b[2m│\u001b[0m\u001b[2m  CAMERA [w]\u001b[0m              \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [s] for sensor calibration (gyro / accel / level / compass / baro)                                                                                      \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[48.321453, "o", "\u001b[2m│\u001b[0m\u001b[2m  RC INPUT [r]\u001b[0m            \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m On the map, [i] saves a pinned satellite image to ./px4_maps                                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[48.321498, "o", "\u001b[2m│\u001b[0m\u001b[2m  USB / NETWORK [u]\u001b[0m       \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [l] for PX4 flight logs; downloads go to ./px4_logs ([u] upload to web, [a] EKF health-check)                                                           \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[48.321552, "o", "\u001b[2m│\u001b[0m\u001b[2m  CONTROL [c]\u001b[0m             \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [f] to flash firmware from ./px4_firmware                                                                                                               \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
[48.321598, "o", "\u001b[2m│\u001b[0m\u001b[2m  ESTIMATION [e]\u001b[0m          \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [v] for a LiDAR point-cloud overview (/x500_lidar_3d_cam/livox/points)                                                                                  \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n\u001b[2m│\u001b[0m\u001b[2m  CALIBRATE [s]\u001b[0m           \u001b[2m│\u001b[0m \u001b[1m\u001b[36m│\u001b[0m\u001b[2m08:45:39\u001b[0m \u001b[37mINFO    \u001b[0m Press [r] for RC stick positions / channels, [w] for a camera preview (/x500_lidar_3d_cam/rgb/image)                                                          \u001b[1m\u001b[36m│\u001b[0m\u001b[K\r\n"]
